{
  "name": "passline-mcp",
  "version": "0.1.0",
  "description": "Passline MCP server: read-only tools for a fictional restaurant (Thymewick). Portfolio demo.",
  "license": "MIT",
  "author": "Amir Gad",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "render:floor-plan": "node scripts/render-floor-plan.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "bin": {
    "passline-mcp": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "data"
  ]
}
